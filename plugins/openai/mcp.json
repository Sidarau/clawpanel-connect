{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "clawpanel": {
      "type": "streamable-http",
      "url": "https://clawpanel-mcp.fly.dev/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": ["kb", "work:read"]
          }
        }
      }
    }
  }
}
